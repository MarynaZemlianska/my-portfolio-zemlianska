<div class="modal is-hidden" id="consultationModal">
    <div class="modal-content">

        <span class="modal-close" id="modalClose">&times;</span>

        <h2>{{ t.modal.title }}</h2>
        <p>{{ t.modal.text }}</p>

        <form id="consultationForm">
            <input type="text" name="name" placeholder="{{ t.modal.name }}" required>
            <input type="tel" name="phone" placeholder="{{ t.modal.phone }}" required>
            <textarea name="message" placeholder="{{ t.modal.message }}" rows="4" required></textarea>
            <button type="submit">{{ t.modal.send }}</button>
        </form>

        <div id="toast-success" class="toast toast-success">{{ t.modal.success | safe }}</div>
        <div id="toast-error" class="toast toast-error">{{ t.modal.error }}</div>

    </div>
</div>
