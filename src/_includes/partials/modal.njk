<div class="modal is-hidden" id="consultationModal">
    <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="consultationTitle">

        <button type="button" class="modal-close" id="modalClose" aria-label="{{ t.modal.close }}">&times;</button>

        <h2 id="consultationTitle">{{ t.modal.title }}</h2>
        <p>{{ t.modal.text }}</p>

        <form id="consultationForm" novalidate>
            <input class="hp-field" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="text" name="name" placeholder="{{ t.modal.name }}" aria-label="{{ t.modal.name }}" autocomplete="name" required>
            <input type="tel" name="phone" placeholder="{{ t.modal.phone }}" aria-label="{{ t.modal.phone }}" autocomplete="tel" required>
            <textarea name="message" placeholder="{{ t.modal.message }}" aria-label="{{ t.modal.message }}" rows="4" required></textarea>
            <button type="submit">{{ t.modal.send }}</button>
        </form>

        <div id="toast-success" class="toast toast-success" role="status" aria-live="polite">{{ t.modal.success | safe }}</div>
        <div id="toast-error" class="toast toast-error" role="alert">{{ t.modal.error }}</div>

    </div>
</div>
