{#- Testimonials (every page). Content: src/_data/testimonials.js -#}
{%- set tl = testimonials.labels[lang] -%}
<section class="section-testimonials reviews">
    <h2 class="section-title-testi">{{ tl.title | accentLast | safe }}</h2>

    {#- The list is rendered twice for a seamless loop; the copy is hidden from screen readers. #}
    <div class="reviews-wrapper">
        <section class="reviews-slider" tabindex="0" aria-label="{{ tl.region }}">
            <ul class="reviews-list" style="--reviews-count: {{ testimonials.items | length }}">
                {%- for copy in [false, true] %}
                {%- for item in testimonials.items %}
                <li class="review-card"{% if copy %} aria-hidden="true"{% endif %}>
                    <figure class="review">
                        {%- if item.rating %}
                        <div class="review-rating" role="img" aria-label="{{ tl.rating | replace('{n}', item.rating) }}">
                            {%- for i in range(1, 6) -%}
                            <span class="star{% if i > item.rating %} star-empty{% endif %}" aria-hidden="true">★</span>
                            {%- endfor -%}
                        </div>
                        {%- endif %}
                        {%- if item.date %}
                        <p class="review-date">{{ item.date[lang] }}</p>
                        {%- endif %}
                        <blockquote class="review-text">
                            <p>{{ item.text[lang] }}</p>
                        </blockquote>
                        {%- set name = item.name[lang] if item.name else "" %}
                        {%- set company = item.company[lang] if item.company else "" %}
                        {%- if name or company %}
                        <figcaption class="review-author">
                            {%- if item.photo %}
                            <img class="review-initial review-photo" src="{{ item.photo }}" alt="" width="48" height="48" loading="lazy" decoding="async">
                            {%- else %}
                            {%- set words = (name or company).split(" ") %}
                            <span class="review-initial" aria-hidden="true">{{ words[0][0] | upper }}{{ words[1][0] | upper if words[1] }}</span>
                            {%- endif %}
                            <span class="review-who">
                                {%- if name %}<span class="review-name">{{ name }}</span>{% endif %}
                                {%- if company %}<span class="review-company">{{ company }}</span>{% endif -%}
                            </span>
                        </figcaption>
                        {%- endif %}
                    </figure>
                </li>
                {%- endfor %}
                {%- endfor %}
            </ul>
        </section>
    </div>
</section>
