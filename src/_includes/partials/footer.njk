<footer class="footer">
    <div class="footer-container" id="contacts">

        <div class="footer-logo-item">
            <p class="subtitle-footer">{{ t.footer.subtitle }}</p>
            <p class="footer-lead">{% for line in t.footer.lead %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
            <p class="footer-text">{{ t.footer.text }}</p>
        </div>

        <nav class="footer-nav" aria-label="{{ t.footer.menu }}">
            <h3 class="footer-h3">{{ t.footer.menu }}</h3>
            <ul class="footer-menu">
                <li class="footer-link"><a href="{{ routes.home[lang] }}">{{ t.footer.home }}</a></li>
                <li class="footer-link"><a href="{{ routes.services[lang] }}">{{ t.footer.services }}</a></li>
                <li class="footer-link"><a href="{{ routes.projects[lang] }}">{{ t.footer.projects }}</a></li>
                <li class="footer-link"><a href="{{ routes.contacts[lang] }}">{{ t.footer.contactsPage }}</a></li>
            </ul>
        </nav>

        <div class="footer-contacts">
            <h3 class="footer-h3">{{ t.footer.contacts }}</h3>
            {% set listClass = "contacts-ul" %}
            {% include "partials/contact-list.njk" %}
        </div>

    </div>

    <div class="footer-info">
        <a class="info-item" href="{{ routes.privacy[lang] }}">{{ t.footer.privacy }}</a>

        <p class="info-safety">© {{ "now" | year }} Maryna Zemlianska. {{ t.footer.rights }}</p>
    </div>

    <a href="{{ routes.home[lang] }}" class="footer-logo footer-wordmark">
        <span class="footer-logo-icon">W</span>
        <span class="footer-logo-text">
            <span class="footer-logo-title">eb {LAB}</span>
            <span class="footer-logo-subtitle">ZEMLIANSKA</span>
        </span>
    </a>
</footer>
