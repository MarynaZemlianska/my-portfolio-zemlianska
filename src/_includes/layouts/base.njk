{%- set t = i18n[lang] -%}
<!DOCTYPE html>
<html lang="{{ t.htmlLang }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - {{ t.siteSuffix }}</title>
    <meta name="description" content="{{ description }}">
    {%- if site.url %}
    <link rel="canonical" href="{{ site.url }}{{ routes[key][lang] }}">
    {%- for l in site.languages %}
    <link rel="alternate" hreflang="{{ i18n[l].htmlLang }}" href="{{ site.url }}{{ routes[key][l] }}">
    {%- endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ routes[key][site.languages[0]] }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }} - {{ t.siteSuffix }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ routes[key][lang] }}">
    <meta property="og:image" content="{{ site.url }}/assets/images/og/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="{{ t.ogLocale }}">
    {%- for l in site.languages %}{% if l != lang %}
    <meta property="og:locale:alternate" content="{{ i18n[l].ogLocale }}">
    {%- endif %}{% endfor %}
    <meta name="twitter:card" content="summary_large_image">

    <script type="application/ld+json">{{ {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Person",
                "@id": site.url + "/#person",
                "name": site.name,
                "jobTitle": t.jobTitle,
                "url": site.url + routes.home[lang],
                "email": "mailto:" + site.email,
                "sameAs": site.profiles
            },
            {
                "@type": "WebSite",
                "@id": site.url + "/#website",
                "url": site.url + "/",
                "name": site.name,
                "inLanguage": ["uk", "en"],
                "publisher": { "@id": site.url + "/#person" }
            },
            {
                "@type": "WebPage",
                "url": site.url + routes[key][lang],
                "name": title,
                "description": description,
                "inLanguage": t.htmlLang,
                "isPartOf": { "@id": site.url + "/#website" }
            }
        ]
    } | dump | safe }}</script>
    {%- endif %}
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="preload" as="font" href="/assets/fonts/Inter_18pt-Regular.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="/assets/fonts/Montserrat-ExtraBold.woff2" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ cssUrl }}">
</head>

<body>
    <a class="skip-link" href="#main">{{ t.skipLink }}</a>
    {% include "partials/header.njk" %}

    {{ content | safe }}

    {% include "partials/footer.njk" %}
    {%- if floatingBoxes %}
    <ul class="floating-boxes" aria-hidden="true">
        {%- for i in range(10) %}
        <li></li>
        {%- endfor %}
    </ul>
    {%- endif %}

    {% include "partials/modal.njk" %}

    <button type="button" class="to-top-btn" id="toTopBtn" aria-label="{{ t.toTop }}">
        <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 19V5" />
            <path d="M5 12L12 5L19 12" />
        </svg>
    </button>

    <script src="/assets/js/main.js" type="module"></script>
</body>

</html>
